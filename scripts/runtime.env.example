# Copy this file outside Git and fill in the deployment-specific values.
# These variables are inherited by the authoring session, but are consumed by
# the solver skill only. Keep their values out of prompts and artifacts.
BASE_URL=https://your-internal-model-host/v1
OPENAI_API_KEY=replace-me
MODEL=your-solver-model-name
POSTGRES=postgresql://user:password@db-host:5432/avacore

# Do not put proxy variables in this runtime file. The batch launcher removes
# inherited proxy variables so model traffic remains direct. Set the proxy
# inline only for an external source-retrieval command as required by AGENTS.md.

# Optional aliases accepted by the controller when the deployment uses them.
# API_KEY=replace-me
# KIMI_MODEL=your-model-name
